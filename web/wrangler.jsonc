{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kero-web",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's server entry. The @cloudflare/vite-plugin bundles this
  // into the deployed Worker and wires up the built client as static assets.
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  }

  // To serve from your own domain, add routes once kero.sh is on Cloudflare:
  // "routes": [{ "pattern": "kero.sh", "custom_domain": true }]
}
