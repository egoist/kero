{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src", "plugins", "vite.config.ts"]
}
